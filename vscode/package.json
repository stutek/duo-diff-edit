{
  "name": "duo-diff-edit",
  "publisher": "stutek",
  "displayName": "Duo Diff Edit",
  "description": "Write together with an AI agent, as in Meld: the agent's proposal on the left, your file on the right, blocks copied across either way.",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stutek/duo-diff-edit"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:duo-diff-edit-proposal"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Duo Diff Edit runs git in the workspace, which a repository's configuration can turn into running programs."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configurationDefaults": {
      "diffEditor.codeLens": true
    },
    "commands": [
      {
        "command": "duoDiffEdit.openPair",
        "title": "Open in Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.open",
        "title": "Open in Duo Diff Edit (stage ↔ buffer)"
      },
      {
        "command": "duoDiffEdit.copyLeft",
        "title": "Prefer Mine (Copy Block Left)",
        "category": "Duo Diff Edit",
        "icon": "$(arrow-left)"
      },
      {
        "command": "duoDiffEdit.copyRight",
        "title": "Accept Suggestion (Copy Block Right)",
        "category": "Duo Diff Edit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "duoDiffEdit.copyWordsLeft",
        "title": "Prefer My Words (Copy Changed Words Left)",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.copyWordsRight",
        "title": "Accept Suggested Words (Copy Changed Words Right)",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.stageAgreed",
        "title": "Stage Agreed Lines (Both Sides Alike)",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.stageMine",
        "title": "Stage Mine (Your Change at the Cursor)",
        "category": "Duo Diff Edit",
        "icon": "$(add)"
      },
      {
        "command": "duoDiffEdit.stageFile",
        "title": "Stage File (Your Whole Text)",
        "category": "Duo Diff Edit",
        "icon": "$(check-all)"
      },
      {
        "command": "duoDiffEdit.undo",
        "title": "Undo (Copies Included)",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.redo",
        "title": "Redo (Copies Included)",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.nextBlock",
        "title": "Next Changed Block",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.previousBlock",
        "title": "Previous Changed Block",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.nextWords",
        "title": "Next Changed Words",
        "category": "Duo Diff Edit"
      },
      {
        "command": "duoDiffEdit.previousWords",
        "title": "Previous Changed Words",
        "category": "Duo Diff Edit"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "duoDiffEdit.openPair",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "3_compare"
        },
        {
          "command": "duoDiffEdit.open",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "3_compare"
        }
      ],
      "editor/title": [
        {
          "command": "duoDiffEdit.copyLeft",
          "when": "duoDiffEdit.twoFiles",
          "group": "navigation@-2"
        },
        {
          "command": "duoDiffEdit.copyRight",
          "when": "duoDiffEdit.twoFiles",
          "group": "navigation@-1"
        },
        {
          "command": "duoDiffEdit.stageFile",
          "when": "duoDiffEdit.twoFiles && duoDiffEdit.inGit",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "duoDiffEdit.copyLeft",
          "when": "duoDiffEdit.twoFiles && isInDiffEditor",
          "group": "1_modification@1"
        },
        {
          "command": "duoDiffEdit.copyRight",
          "when": "duoDiffEdit.twoFiles && isInDiffEditor",
          "group": "1_modification@2"
        },
        {
          "command": "duoDiffEdit.stageMine",
          "when": "duoDiffEdit.twoFiles && duoDiffEdit.inGit && isInDiffEditor",
          "group": "1_modification@3"
        }
      ],
      "commandPalette": [
        {
          "command": "duoDiffEdit.open",
          "when": "false"
        },
        {
          "command": "duoDiffEdit.openPair",
          "when": "false"
        },
        {
          "command": "duoDiffEdit.copyLeft",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.copyRight",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.copyWordsLeft",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.copyWordsRight",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.stageAgreed",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.stageMine",
          "when": "duoDiffEdit.twoFiles && duoDiffEdit.inGit"
        },
        {
          "command": "duoDiffEdit.stageFile",
          "when": "duoDiffEdit.twoFiles && duoDiffEdit.inGit"
        },
        {
          "command": "duoDiffEdit.undo",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.redo",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.nextBlock",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.previousBlock",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.nextWords",
          "when": "duoDiffEdit.twoFiles"
        },
        {
          "command": "duoDiffEdit.previousWords",
          "when": "duoDiffEdit.twoFiles"
        }
      ]
    },
    "keybindings": [
      {
        "command": "duoDiffEdit.copyLeft",
        "key": "alt+left",
        "mac": "ctrl+alt+left",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.copyRight",
        "key": "alt+right",
        "mac": "ctrl+alt+right",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.previousBlock",
        "key": "alt+up",
        "mac": "ctrl+alt+up",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.nextBlock",
        "key": "alt+down",
        "mac": "ctrl+alt+down",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.copyWordsLeft",
        "key": "shift+alt+left",
        "mac": "ctrl+shift+alt+left",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.copyWordsRight",
        "key": "shift+alt+right",
        "mac": "ctrl+shift+alt+right",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.previousWords",
        "key": "shift+alt+up",
        "mac": "ctrl+shift+alt+up",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      },
      {
        "command": "duoDiffEdit.nextWords",
        "key": "shift+alt+down",
        "mac": "ctrl+shift+alt+down",
        "when": "duoDiffEdit.twoFiles && isInDiffEditor && editorTextFocus"
      }
    ]
  }
}
